# Database (TiDB Cloud Serverless)
DATABASE_URL="mysql://<user>:<password>@<host>:4000/<database>?ssl=true"

# NextAuth (Admin Authentication)
AUTH_SECRET="your-32-char-random-secret-here"
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"
ADMIN_EMAILS_ALLOWLIST="admin@example.com,dev@example.com"

# Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Media Storage
# Cloudinary (Catalog Media)
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
# Cloudflare R2 / Vercel Blob (Private Memories)
R2_ACCOUNT_ID="your-cloudflare-account-id"
R2_ACCESS_KEY_ID="your-r2-access-key-id"
R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
R2_BUCKET_NAME="datemate-memories"
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Rate Limiting & Anti-Bot
UPSTASH_REDIS_REST_URL="https://<your-upstash-redis>.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."

# Web Push (VAPID)
VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"

# Cron Job Secret
CRON_SECRET="your-secure-cron-secret-token"

# AI Integration (Google AI Studio - 100% Free Tier)
GEMINI_API_KEY="AIzaSy..."

# Search Configuration
SEARCH_MODE="like"

UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

GEMINI_API_KEY=
YOUTUBE_API_KEY=

IP_GEOLOCATION_API_KEY=