{
  "name": "datemate",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "node --env-file=.env scripts/migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "db:check": "node --env-file=.env scripts/check-db.mjs",
    "db:publish": "node --env-file=.env scripts/publish-seed-places.mjs",
    "media:fetch": "node --env-file-if-exists=.env --experimental-strip-types --no-warnings=ExperimentalWarning scripts/fetch-place-media.ts",
    "media:import": "node --env-file=.env --experimental-strip-types --no-warnings=ExperimentalWarning scripts/import-place-media.ts",
    "cron:pipeline": "npx tsx --env-file=.env scripts/pipeline/run-full-ingestion-cron.ts",
    "video:publish": "npx tsx --env-file=.env scripts/pipeline/publish-all-videos.ts",
    "crawl:couple": "npx tsx --env-file=.env scripts/pipeline/crawl-couple-videos.ts",
    "places:ingest-fun": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx --env-file=.env scripts/pipeline/cron-ingest-fun-places.ts",
    "places:promote-all": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx --env-file=.env scripts/pipeline/bulk-promote-all-candidates.ts",
    "places:expand": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx --env-file=.env scripts/pipeline/ingest-more-hanoi-places.ts",
    "pipeline:daily": "NODE_TLS_REJECT_UNAUTHORIZED=0 npx tsx --env-file=.env scripts/pipeline/daily-auto-pipeline.ts"
  },
  "dependencies": {
    "@google/genai": "^2.31.0",
    "@hookform/resolvers": "^3.9.1",
    "@tanstack/react-query": "^5.66.0",
    "@tidbcloud/serverless": "^0.3.0",
    "archiver": "^8.0.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "nanoid": "^5.1.0",
    "next": "^15.2.0",
    "next-auth": "^4.24.11",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "sharp": "^0.35.5",
    "suncalc": "^1.9.0",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/suncalc": "^1.9.2",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.30.4",
    "eslint": "^9.20.1",
    "eslint-config-next": "^15.2.0",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
